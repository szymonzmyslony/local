/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zine",
	"main": "src/server.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_names": true,

	"assets": {
		"directory": "public",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*", "/webhook", "/health"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "Zine",
				"class_name": "Zine"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Zine"
			]
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true
		}
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "chat.zinelocal.com", "zone_name": "zinelocal.com", "custom_domain": true }
	]
	

}
