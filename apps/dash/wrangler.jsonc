/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dash",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_names": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"browser": { "binding": "BROWSER", "remote": true },
	"services": [
		{ "binding": "OBSERVER", "service": "zine-observer" }
	],
	"vars": {
		"DASH_ADMIN_USERNAME": "zine"
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "admin.zinelocal.com", "zone_name": "zinelocal.com", "custom_domain": true }
	],
	
	"workflows": [
		{ "name": "discover-links", "binding": "DISCOVER_LINKS", "class_name": "DiscoverLinks" },
		{ "name": "scrape-pages",   "binding": "SCRAPE_PAGES",   "class_name": "ScrapePages"   },
		{ "name": "classify-page",  "binding": "CLASSIFY_PAGE",  "class_name": "ClassifyPage"  },
		{ "name": "extract-event-pages",  "binding": "EXTRACT_EVENT_PAGES",  "class_name": "ExtractEventPages"  },
		{ "name": "extract-and-embed-events",  "binding": "EXTRACT_AND_EMBED_EVENTS",  "class_name": "ExtractAndEmbedEvents"  },
		{ "name": "extract-gallery",  "binding": "EXTRACT_GALLERY",  "class_name": "ExtractGallery"  },
		{ "name": "embed",          "binding": "EMBEDDING",      "class_name": "Embed"         },
		{ "name": "seed-and-startup-gallery",  "binding": "SEED_AND_STARTUP_GALLERY",  "class_name": "SeedAndStartupGallery"  }
	  ],
	
}
